<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <Version>0.0.2</Version>
        <TargetFramework>net8.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <Platforms>AnyCPU</Platforms>
        
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    </PropertyGroup>

    <ItemGroup>
        <ProjectReference Include="..\WoowzLib.Core\WoowzLib.Core.csproj" />
        <ProjectReference Include="..\WoowzLib.Input\WoowzLib.Input.csproj" />
        <ProjectReference Include="..\WoowzLib.Logger\WoowzLib.Logger.csproj" />
    </ItemGroup>

    <ItemGroup>
      <PackageReference Include="ImGui.NET" Version="1.91.6.1" />
    </ItemGroup>

    <Target Name="PreBuild" BeforeTargets="PreBuildEvent">
        <Exec Command="&quot;$(ProjectDir)..\..\CSVersionUpdater\CSVersionUpdater\bin\Debug\net8.0\CSVersionUpdater.exe&quot; &quot;$(MSBuildProjectFullPath)&quot;" />
    </Target>

</Project>